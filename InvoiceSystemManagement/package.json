{
  "name": "invoicesystemmanagement",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.15",
    "@react-navigation/native-stack": "^7.18.7",
    "axios": "^1.19.0",
    "babel-preset-expo": "~57.0.0",
    "exceljs": "^4.4.0",
    "expo": "~57.0.11",
    "expo-apple-authentication": "~57.0.1",
    "expo-auth-session": "~57.0.6",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.2",
    "expo-image-manipulator": "~57.0.8",
    "expo-linear-gradient": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.10",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.30.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-calendars": "^1.1314.0",
    "react-native-document-scanner-plugin": "^2.0.4",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-pie-chart": "^4.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.17"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:report": "jest --coverage"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|react-native-svg|lucide-react-native|nativewind|react-native-reanimated|react-native-gifted-charts|react-native-pie-chart|react-native-document-scanner-plugin)"
    ],
    "reporters": [
      "default",
      [
        "jest-html-reporter",
        {
          "pageTitle": "Reporte de Pruebas - Invoice System Management",
          "outputPath": "./test-report.html",
          "includeFailureMsg": true,
          "includeConsoleLog": false
        }
      ]
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/**/node_modules/**"
    ]
  },
  "private": true,
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.0.1",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.4",
    "jest-html-reporter": "^4.4.0",
    "react-test-renderer": "^19.2.3"
  }
}
